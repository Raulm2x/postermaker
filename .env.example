# ==============================================================================
# PosterMaker - Archivo de Ejemplo de Variables de Entorno (.env.example)
# ==============================================================================
# Este archivo documenta todas las variables de entorno reconocidas por
# PosterMaker.
#
# Comportamiento por defecto:
# Si no configuras ninguna de estas variables, PosterMaker se ejecuta siempre
# en MODO LOCAL (escritorio), mostrando los botones de actualización y apagado,
# habilitando la comprobación automática de nuevas versiones y liberando recursos
# al cerrar pestañas.
#
# Para despliegues en la nube (ej. Render.com):
# Configura estas variables en el panel de control de tu servicio:
# Dashboard de Render -> Environment -> Environment Variables.
# (Nota: Render define automáticamente RENDER=true, por lo que detectará
# el modo cloud incluso sin configurar variables adicionales).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO Y MODO DE OPERACIÓN
# ------------------------------------------------------------------------------
# POSTERMAKER_ENV:
# Define el entorno de ejecución.
# Opciones locales: "local", "dev", "development" (por defecto: local)
# Opciones en la nube: "cloud", "production", "staging"
POSTERMAKER_ENV=local

# POSTERMAKER_LOCAL:
# Fuerza explícitamente el modo local ("1", "true") o modo nube ("0", "false").
# Por defecto: 1 (modo local).
# En Render, puedes establecer POSTERMAKER_LOCAL=0 si deseas ser 100% explícito.
POSTERMAKER_LOCAL=1

# POSTERMAKER_CLOUD:
# Alternativa para forzar modo cloud ("1", "true") o local ("0", "false").
# Por defecto: 0.
POSTERMAKER_CLOUD=0

# ------------------------------------------------------------------------------
# 2. RED, HOST Y PUERTO
# ------------------------------------------------------------------------------
# HOST:
# Dirección IP en la que escuchará el servidor web.
# - En local: 127.0.0.1 (seguro para tu máquina personal).
# - En la nube / contenedores Docker: 0.0.0.0 (para recibir tráfico externo).
HOST=127.0.0.1

# PORT:
# Puerto en el que escuchará el servidor web.
# - En local: 8000 por defecto.
# - En Render: Render inyecta automáticamente la variable PORT (ej. 10000).
PORT=8000

# ------------------------------------------------------------------------------
# 3. ALMACENAMIENTO TEMPORAL
# ------------------------------------------------------------------------------
# POSTERMAKER_OUTPUT:
# Directorio donde se guardan temporalmente las imágenes procesadas y los PDF
# generados antes de ser descargados por el usuario.
# En Linux/macOS por defecto: /tmp/postermaker
POSTERMAKER_OUTPUT=/tmp/postermaker

# ------------------------------------------------------------------------------
# 4. GESTIÓN DE INACTIVIDAD
# ------------------------------------------------------------------------------
# IDLE_TIMEOUT:
# Segundos de inactividad antes de cerrar el proceso y liberar memoria RAM.
# - En local: 900 (15 minutos).
# - En la nube / Render: 0 (desactivado, para que el servicio permanezca 24/7).
IDLE_TIMEOUT=900
